tests {
  test("422 + Sport inconnu", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody().title).to.equal("Sport inconnu");
  });
}

docs {
  `tennis` n'a pas de plugin enregistré → 422. Ajouter un sport = ajouter un plugin
  backend, aucune modif du socle.
}
