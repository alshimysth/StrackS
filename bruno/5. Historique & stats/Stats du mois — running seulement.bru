meta {
  name: Stats du mois — running seulement
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/stats/summary?period=month&sport=running&tz=Europe/Paris
  body: none
  auth: inherit
}

params:query {
  period: month
  sport: running
  tz: Europe/Paris
}

tests {
  test("200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("le filtre sport restreint bySport", function () {
    const bySport = res.getBody().bySport;
    expect(bySport.every((s) => s.sportType === "running")).to.equal(true);
  });
}

docs {
  `period` : `week` (défaut), `month` ou `year` — 400 sinon.
  `sport` : code du registre, 422 si inconnu.
  `tz` : identifiant IANA, 400 si invalide.

  `from` désigne un instant **dans** la période voulue, pas sa borne basse : envoyer
  n'importe quelle date de juillet ramène juillet entier. C'est ce qui fait marcher la
  navigation de mois en mois de l'écran de statistiques.
}
