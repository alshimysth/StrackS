meta {
  name: 4.4 Reprendre
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/activities/{{activityId}}/resume
  body: none
  auth: inherit
}

tests {
  test("200 OK + statut in_progress", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("in_progress");
  });
}

docs {
  POST sans corps. Le temps de pause est cumulé côté serveur (`pausedTotalS`). Depuis
  `paused` uniquement.
}
