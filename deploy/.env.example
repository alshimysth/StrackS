# Template of the variables expected by docker-compose.prod.yml ON THE VPS.
#
# On the VPS, in the deployment directory (e.g. /root/stracks):
#   1. Copy this file to `.env` and fill in the real values.
#   2. Generate the JWT keys once (never committed):
#        mkdir -p keys
#        openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out keys/privateKey.pem
#        openssl rsa -pubout -in keys/privateKey.pem -out keys/publicKey.pem
#   3. IMPORTANT, permissions: the backend container runs as UID 185 (non-root).
#      The private key (mode 600 root) must be readable by it, otherwise SmallRye fails
#      at startup with "SRJWT05028: Signing key can not be created". Give ownership to
#      185 while keeping mode 600:
#        chown 185:185 keys/privateKey.pem
#   4. The deployment workflow drops docker-compose.prod.yml here, then runs
#      `docker compose -f docker-compose.prod.yml up -d`.
#
# NEVER commit the real `.env` nor the *.pem files.

# PostgreSQL credentials (shared by the postgres container and the backend)
DATABASE_USER=stracks
DATABASE_PASSWORD=

# JDBC URL inside the compose network (`postgres` service); don't change unless needed
DATABASE_URL=jdbc:postgresql://postgres:5432/stracks

# Directory (on the VPS) holding privateKey.pem + publicKey.pem, mounted read-only
JWT_KEYS_DIR=./keys

# --- Backups (#45). Procedure: docs/release/RUNBOOK.md, backups section.
# Leave COMPOSE_PROFILES empty as long as the remote storage doesn't exist: the `backup`
# service then doesn't start. Once everything is filled in: COMPOSE_PROFILES=backup
COMPOSE_PROFILES=
BACKUP_BUCKET=
# Optional subfolder in the bucket
BACKUP_PREFIX=
# UTC time of the daily backup
BACKUP_AT=03:15
# Cloudflare R2 (recommended, lot A): https://<ACCOUNT_ID>.r2.cloudflarestorage.com
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
# Optional: monitoring URL (e.g. healthchecks.io) called on each success, and suffixed
# with /fail on failure; a backup that silently stops is the real danger.
BACKUP_PING_URL=
# The GPG PUBLIC key goes in backup/keys/backup-public.asc (never the private one).

# --- Error monitoring (lot 5): leave empty to disable.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

