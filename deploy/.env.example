# Modèle des variables attendues par docker-compose.prod.yml SUR LE VPS.
#
# Sur le VPS, dans le répertoire de déploiement (ex. /root/stracks) :
#   1. Copier ce fichier en `.env` et renseigner les vraies valeurs.
#   2. Générer les clés JWT une seule fois (jamais commitées) :
#        mkdir -p keys
#        openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out keys/privateKey.pem
#        openssl rsa -pubout -in keys/privateKey.pem -out keys/publicKey.pem
#   3. IMPORTANT — permissions : le conteneur backend tourne en UID 185 (non-root).
#      La clé privée (mode 600 root) doit lui être lisible, sinon SmallRye échoue
#      au démarrage avec "SRJWT05028: Signing key can not be created". Donner la
#      propriété au 185 en gardant le mode 600 :
#        chown 185:185 keys/privateKey.pem
#   4. Le workflow de déploiement dépose docker-compose.prod.yml ici, puis
#      `docker compose -f docker-compose.prod.yml up -d`.
#
# NE JAMAIS committer le `.env` réel ni les *.pem.

# Identifiants PostgreSQL (le conteneur postgres et le backend les partagent)
DATABASE_USER=stracks
DATABASE_PASSWORD=

# URL JDBC interne au réseau compose (service `postgres`) — ne pas changer sauf besoin
DATABASE_URL=jdbc:postgresql://postgres:5432/stracks

# Répertoire (sur le VPS) contenant privateKey.pem + publicKey.pem, monté en lecture seule
JWT_KEYS_DIR=./keys
