meta {
  name: Historique paginé
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/activities?page=0&size=20
  body: none
  auth: inherit
}

params:query {
  page: 0
  size: 20
  ~sport: running
  ~from: 2026-07-01T00:00:00Z
  ~to: 2026-08-01T00:00:00Z
}

tests {
  test("200 OK + page d'activités", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.all.keys("items", "page", "size", "total");
  });
}

docs {
  Tri : plus récentes d'abord. Filtres optionnels (décochés) : `sport`, `from`/`to`
  (ISO 8601, borne haute exclusive). `size` max 100.
}
