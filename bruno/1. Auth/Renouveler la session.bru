meta {
  name: Renouveler la session
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

tests {
  test("200 OK + nouvelle paire de jetons", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.token).to.be.a("string").and.not.empty;
    expect(body.refreshToken).to.not.equal(bru.getVar("refreshToken"));
    bru.setVar("token", body.token);
    bru.setVar("refreshToken", body.refreshToken);
  });
}

docs {
  Rotation du refresh token (#44). Le JWT d'accès ne vit que 15 min (#49) : c'est ce
  que fait le client mobile, en silence, à chaque 401. L'ancien refresh token devient
  inutilisable (au-delà d'une fenêtre de tolérance de 60 s).
}
