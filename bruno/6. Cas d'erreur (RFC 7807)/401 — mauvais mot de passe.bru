meta {
  name: 401 — mauvais mot de passe
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "mauvais-mot-de-passe"
  }
}

tests {
  test("401 + problème RFC 7807", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().title).to.equal("Identifiants invalides");
  });
}

docs {
  À lancer après Register/Login (nécessite `{{userEmail}}` déjà renseigné).
}
