meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
  }
}

tests {
  test("200 OK + token JWT", function () {
    expect(res.getStatus()).to.equal(200);
  });
  const body = res.getBody();
  expect(body.token).to.be.a("string").and.not.empty;
  bru.setVar("token", body.token);
}

docs {
  Reconnexion avec le compte créé par Register (variables `{{userEmail}}` / `{{userPassword}}`).
  Rafraîchit `{{token}}`.
}
